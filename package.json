{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint:design-tokens": "node scripts/lint-design-tokens.js",
        "lint:arbitrary-px": "node scripts/lint-design-tokens.js 2>&1 | grep -c ARBITRARY_PX || true",
        "lint:touch-targets": "node scripts/lint-design-tokens.js 2>&1 | grep -c SMALL_TOUCH_TARGET || true",
        "lint:colors": "node scripts/lint-design-tokens.js 2>&1 | grep -c HARDCODED_COLOR || true",
        "lint:ui": "npm run lint:design-tokens"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "fontaine": "^0.8.2",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.17.4",
        "@alpinejs/focus": "^3.17.4",
        "alpinejs": "^3.17.4"
    }
}
