APP_NAME=SRMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE CONFIGURATION ---
# DB_CONNECTION: The database driver (pgsql for PostgreSQL, sqlite, mysql, etc.)
DB_CONNECTION=pgsql
# DB_HOST: The hostname or IP address of the database server
DB_HOST=127.0.0.1
# DB_PORT: The port the database server is listening on
DB_PORT=5432
# DB_DATABASE: The name of the database to connect to
DB_DATABASE=ethio_real_estate
# DB_USERNAME: The database user
DB_USERNAME=postgres
# DB_PASSWORD: The database password
DB_PASSWORD=postgres

# --- SESSION CONFIGURATION ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- BROADCAST, FILESYSTEM, QUEUE ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- CACHE CONFIGURATION ---
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- REDIS CONFIGURATION ---
# REDIS_CLIENT: The Redis client to use (phpredis or predis)
REDIS_CLIENT=phpredis
# REDIS_HOST: The hostname or IP address of the Redis server
REDIS_HOST=127.0.0.1
# REDIS_PASSWORD: The password for the Redis server
REDIS_PASSWORD=null
# REDIS_PORT: The port the Redis server is listening on
REDIS_PORT=6379

# --- MAIL CONFIGURATION ---
# MAIL_MAILER: The mail driver (log, smtp, mailgun, postmark, ses, sendmail)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS CONFIGURATION ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- FRONTEND ---
VITE_APP_NAME="${APP_NAME}"

